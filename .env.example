# Local PostgreSQL only; the Docker port is bound to 127.0.0.1.
# Set your local password before the first docker compose up.
# Changing it after initialization also requires updating the existing DB user's password.
POSTGRES_DB=superstore_db
POSTGRES_USER=superstore
POSTGRES_PASSWORD=superstore_local_change_me
POSTGRES_PORT=5433
DB_HOST=localhost
DB_PORT=5433

# Relative paths are resolved from the folder containing config.py.
CSV_PATH=data/raw/superstore.csv
OUTPUT_DIR=outputs

# Download a service-account key into credentials.json locally.
# Share ONLY the intended spreadsheet with the service-account email as Editor.
# GOOGLE_SHEET_ID is the part between /d/ and /edit in its browser URL.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=dashboard_data
